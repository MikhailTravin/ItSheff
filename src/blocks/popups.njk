<!--Пополнить баланс-->
<div id="balance" aria-hidden="false" class="popup popup-balance">
    <div class="popup__wrapper">
        <div class="popup__content">
            <form action="#" class="popup__step active">
                <div class="popup-top">
                    <div class="popup-top__titles">
                        <div class="popup-top__title">
                            Пополнить баланс
                        </div>
                    </div>
                    <div data-close class="popup-top__close">
                        <svg aria-hidden="true" width="22" height="22">
                            <use xlink:href="img/sprite.svg#close"></use>
                        </svg>
                    </div>
                </div>
                <div class="popup-center">
                    <div class="popup-balance-center">
                        <div class="popup-balance-center__title">
                            Последние транзакции:
                        </div>
                        <div class="popup-balance-center__body">
                            <div class="popup-balance-center__column">
                                <div class="popup-balance-center__price">
                                    15 900 ₸
                                </div>
                                <div class="popup-balance-center__item">
                                    <div class="popup-balance-center__name">
                                        Возврат денежных средств клиенту
                                    </div>
                                    <div class="popup-balance-center__data">31.01.2026 10:36:45</div>
                                </div>
                            </div>
                            <div class="popup-balance-center__column">
                                <div class="popup-balance-center__price">
                                    15 900 ₸
                                </div>
                                <div class="popup-balance-center__item">
                                    <div class="popup-balance-center__name">
                                        Возврат денежных средств клиенту
                                    </div>
                                    <div class="popup-balance-center__data">31.01.2026 10:36:45</div>
                                </div>
                            </div>
                            <div class="popup-balance-center__column">
                                <div class="popup-balance-center__price">
                                    15 900 ₸
                                </div>
                                <div class="popup-balance-center__item">
                                    <div class="popup-balance-center__name">
                                        Возврат денежных средств клиенту
                                    </div>
                                    <div class="popup-balance-center__data">31.01.2026 10:36:45</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--Не было ни одной транзакции
                    <div class="popup-buttons-balance">
                        <div class="popup-buttons">
                            <div class="form">
                                <div class="form__inputs">
                                    <div class="form__input form-price">
                                        <div class="form__currency">₸</div>
                                        <input data-required data-error="Reason for the error" autocomplete="off"
                                            type="text" name="form[]" placeholder="12 000" value="12 000"
                                            class="input input-price">
                                    </div>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-bg btn-next">
                                <span>Пополнить</span>
                            </button>
                        </div>
                    </div>-->
                </div>
                <div class="popup-buttons popup-buttons-grid2">
                    <div class="form">
                        <div class="form__inputs">
                            <div class="form__input form-price">
                                <div class="form__currency">₸</div>
                                <input data-required data-error="Reason for the error" autocomplete="off" type="text"
                                    name="form[]" placeholder="12 000" value="12 000" class="input input-price">
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-bg btn-next">
                        <span>Пополнить</span>
                    </button>
                </div>
            </form>
            <div style="display: none;" class="popup__step">
                <div class="popup-top">
                    <div class="popup-top__titles">
                        <div class="popup-top__title">
                            Форма оплаты
                        </div>
                    </div>
                    <div data-close class="popup-top__close">
                        <svg aria-hidden="true" width="22" height="22">
                            <use xlink:href="img/sprite.svg#close"></use>
                        </svg>
                    </div>
                </div>
                <div class="popup-center">
                    <div class="popup-balance-invoice">
                        <div class="popup-balance-invoice__titles">
                            <div class="popup-balance-invoice__title">
                                Мы сформировали счет:
                            </div>
                            <div class="popup-balance-invoice__number">
                                №123456
                            </div>
                        </div>
                        <div class="popup-balance-invoice__price">
                            12 000 ₸
                        </div>
                    </div>
                </div>
                <div class="popup-buttons popup-buttons-grid2">
                    <a href="./" class="btn">
                        <span>Оплатить картой</span>
                    </a>
                    <a href="./" class="btn btn-bg">
                        <span>Оплатить по счету</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>