                            <use xlink:href="img/sprite.svg#close"></use>
                        </svg>
                    </div>
                </div>
                <div class="popup-center">
                    <div class="popup-other__body">
                        <div class="popup-other__name">
                            Сбросить пароль?
                        </div>
                        <div class="popup-other__title">
                            Вы уверены что хотите сбросить паоль? Новый пароль будет отправлен на почту
                        </div>
                    </div>
                </div>
                <div class="popup-buttons">
                    <button type="button" data-close class="btn">
                        <span>Отмена</span>
                    </button>
                    <button data-close data-btn="#btn-sent6" type="button" class="btn btn-bg">
                        <span>Сбросить</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!--Выбить-->
    <div id="kick-user" aria-hidden="false" class="popup popup-other popup-users">
