                <div class="popup-center">
                    <div class="popup-other__body">
                        <div class="popup-other__name">
                            Выбить пользователя?
                        </div>
                        <div class="popup-other__title">
                            Необходим короткий текст, объясняющий действия операции
                        </div>
                    </div>
                </div>
                <div class="popup-buttons">
                    <button type="button" data-close class="btn">
                        <span>Отмена</span>
                    </button>
                    <button data-close data-btn="#btn-sent7" type="button" class="btn btn-bg">
                        <span>Выбить</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!--Удалить-->
    <div id="delete-user" aria-hidden="false" class="popup popup-other popup-users">
        <div class="popup__wrapper">
            <div class="popup__content">
                <div class="popup-top">
                    <div class="popup-top__titles">
                        <div class="popup-top__title">
                            Удалить пользователя?
                        </div>
                    </div>
                    <div data-close class="popup-top__close">
                        <svg aria-hidden="true" width="22" height="22">
                            <use xlink:href="img/sprite.svg#close"></use>
                        </svg>
                    </div>
                </div>
                <div class="popup-center">
                    <div class="popup-other__body">
                        <div class="popup-other__name">
                            Удалить пользователя?
                        </div>
                        <div class="popup-other__name-user">
                            Имя пользователя
                        </div>
                        <div class="popup-other__title">
