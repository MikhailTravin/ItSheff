                                        </span>
                                        <span class="checkbox__text">
                                            TOO DREMERCHANNEL
                                        </span>
                                    </span>
                                </label>
                            </div>
                            <button hidden data-showmore-button type="button" class="select-bases-showmore__more">
                                <svg aria-hidden="true" width="14" height="14">
                                    <use xlink:href="img/sprite.svg#plus1"></use>
                                </svg>
                                Показать еще (10)
                            </button>
                        </div>
                    </div>
                </div>
                <div class="popup-buttons">
                    <button data-close data-btn="#btn-sent1" type="submit" class="btn btn-bg">
                        <span>Сохранить</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!--Сбросить пароль-->
