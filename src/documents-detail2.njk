                            <div class="block-documents-api__column">
                                <script id="swagger-data" type="application/json">
{
  "spec": {
    "openapi": "3.0.0",
    "info": {
      "title": "Public ITSheff API",
      "version": "1.0.0"
    },
    "paths": {
      "/api/client_user/create": {
        "post": {
          "tags": [
            "ClientUser"
          ],
          "summary": "Создать нового пользователя клиента",
          "operationId": "post_api_client_user_create",
          "parameters": [
            {
              "name": "Authorization",
              "in": "header",
              "description": "JWT-токен в формате: `Bearer <токен>`",
              "required": true,
              "schema": {
                "type": "string",
                "pattern": "^Bearer .+$",
                "example": "Bearer xxxxxxxx"
              }
            }
          ],
          "requestBody": {
            "description": "Параметры запроса (form-data)",
            "content": {
              "application/x-www-form-urlencoded": {
                "schema": {
                  "required": [
                    "fio",
                    "role"
                  ],
                  "properties": {
                    "fio": {
                      "description": "ФИО пользователя",
                      "type": "string",
                      "example": "Иванов Иван Иванович"
                    },
                    "role": {
                      "description": "Роль пользователя. Допустимые значения: manager, buh, admin",
                      "type": "string",
                      "enum": [
                        "manager",
                        "buh",
                        "admin"
                      ],
                      "example": "manager"
                    },
                    "azure_login": {
                      "description": "Логин Azure, имеет смысл только если подключена OAuth Azure(не обязательный параметр)",
                      "type": "string",
                      "example": "azure_login"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Пользователь создан успешно",
              "content": {
                "application/json": {
                  "schema": {
                    "properties": {
                      "login": {
                        "type": "string",
                        "example": "ivanov"
                      },
                      "password": {
                        "type": "string",
                        "example": "secure123"
                      }
                    },
                    "type": "object"
                  }
                }
              }
            },
            "400": {
              "description": "Неверные параметры запроса"
            },
            "401": {
              "description": "Требуется авторизация (Bearer JWT)"
            },
            "500": {
              "description": "Внутренняя ошибка сервера"
            }
          }
        }
      },
      "/api/client_user/{login}": {
        "delete": {
          "tags": [
            "ClientUser"
          ],
          "summary": "Удалить пользователя клиента",
          "operationId": "delete_api_client_user_delete",
          "parameters": [
            {
              "name": "Authorization",
              "in": "header",
              "description": "JWT-токен в формате: `Bearer <токен>`",
              "required": true,
              "schema": {
                "type": "string",
                "pattern": "^Bearer .+$",
                "example": "Bearer xxxxxxxx"
              }
            },
            {
              "name": "login",
              "in": "path",
              "description": "login пользователя, который нужно удалить",
              "required": true,
              "schema": {
                "type": "string",
                "example": "client_user_login"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Пользователь удален успешно",
              "content": {
                "application/json": {
                  "schema": {
                    "properties": {
                      "success": {
                        "type": "boolean",
                        "example": "true"
                      }
                    },
                    "type": "object"
                  }
                }
              }
            },
            "400": {
              "description": "Неверные параметры запроса"
            },
            "401": {
              "description": "Требуется авторизация (Bearer JWT)"
            },
            "500": {
              "description": "Внутренняя ошибка сервера"
            }
          }
        }
      },
      "/api/token": {
        "post": {
          "tags": [
            "Token"
          ],
          "summary": "Получить токен для работы с API. токен действует год",
          "operationId": "post_api_get_token",
          "requestBody": {
            "description": "Параметры запроса (form-data)",
            "content": {
              "application/x-www-form-urlencoded": {
                "schema": {
                  "required": [
                    "login",
                    "password"
                  ],
                  "properties": {
                    "login": {
                      "description": "логин пользователя",
                      "type": "string",
                      "example": "ivanov"
                    },
                    "password": {
                      "description": "пароль пользователя",
                      "type": "string",
                      "example": "secure123"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Токен создан успешно",
              "content": {
                "application/json": {
                  "schema": {
                    "properties": {
                      "token": {
                        "type": "string",
                        "example": "xxxxx.xxxxx.xxxx"
                      }
                    },
                    "type": "object"
                  }
                }
              }
            },
            "400": {
              "description": "Неверные параметры запроса"
            },
            "401": {
              "description": "Требуется авторизация (логин пароль)"
            },
            "500": {
              "description": "Внутренняя ошибка сервера"
            }
          }
        }
      },
      "/api/client_base/list": {
        "get": {
          "tags": [
            "ClientBase"
          ],
          "summary": "Получить список баз клиента",
          "operationId": "get_api_get_client_base_list",
          "parameters": [
            {
              "name": "Authorization",
              "in": "header",
              "description": "JWT-токен в формате: `Bearer <токен>`",
              "required": true,
              "schema": {
                "type": "string",
                "pattern": "^Bearer .+$",
                "example": "Bearer xxxxxxxx"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Запрос успешно выполнен. Возвращен список баз.",
              "content": {
                "application/json": {
                  "schema": {
                    "properties": {
                      "bases": {
                        "type": "array",
                        "items": {
                          "properties": {
                            "id": {
                              "type": "integer",
                              "example": 3334
                            },
                            "name": {
                              "type": "string",
                              "example": "ТОО База Клиента"
                            }
                          },
                          "type": "object"
                        }
                      }
                    },
                    "type": "object"
                  }
                }
              }
            },
            "400": {
              "description": "Неверные параметры запроса"
            },
            "401": {
              "description": "Требуется авторизация (Bearer JWT)"
            },
            "500": {
              "description": "Внутренняя ошибка сервера"
            }
          }
        }
      },
      "/api/client_user/grant_access/{login}/{base}": {
        "put": {
          "tags": [
            "ClientUser",
            "ClientBase"
          ],
          "summary": "Предоставить доступ пользователю к базе",
          "operationId": "put_api_client_user_grant_access_to_base",
          "parameters": [
            {
              "name": "Authorization",
              "in": "header",
              "description": "JWT-токен в формате: `Bearer <токен>`",
              "required": true,
              "schema": {
                "type": "string",
                "pattern": "^Bearer .+$",
                "example": "Bearer xxxxxxxx"
              }
            },
            {
              "name": "login",
              "in": "path",
              "description": "login пользователя, которому нужно предоставить доступ",
              "required": true,
              "schema": {
                "type": "string",
                "example": "client_user_login"
              }
            },
            {
              "name": "base",
              "in": "path",
              "description": "идентификатор базы, к которой нужно предоставить доступ",
              "required": true,
              "schema": {
                "type": "integer",
                "example": 345
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Доступ предоставлен",
              "content": {
                "application/json": {
                  "schema": {
                    "properties": {
                      "success": {
                        "type": "boolean",
                        "example": "true"
                      }
                    },
                    "type": "object"
                  }
                }
              }
            },
            "400": {
              "description": "Неверные параметры запроса"
            },
            "401": {
              "description": "Требуется авторизация (Bearer JWT)"
            },
            "500": {
              "description": "Внутренняя ошибка сервера"
            }
          }
        }
      },
      "/api/client_user/remove_access/{login}/{base}": {
        "put": {
          "tags": [
            "ClientUser",
            "ClientBase"
          ],
          "summary": "Запретить доступ пользователя  к базе",
          "operationId": "put_api_client_user_remove_access_to_base",
          "parameters": [
            {
              "name": "Authorization",
              "in": "header",
              "description": "JWT-токен в формате: `Bearer <токен>`",
              "required": true,
              "schema": {
                "type": "string",
                "pattern": "^Bearer .+$",
                "example": "Bearer xxxxxxxx"
              }
            },
            {
              "name": "login",
              "in": "path",
              "description": "login пользователя, которому нужно запретить доступ",
              "required": true,
              "schema": {
                "type": "string",
                "example": "client_user_login"
              }
            },
            {
              "name": "base",
              "in": "path",
              "description": "идентификатор базы, к которой нужно запретить доступ",
              "required": true,
              "schema": {
                "type": "integer",
                "example": 345
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Доступ запрещен",
              "content": {
                "application/json": {
                  "schema": {
                    "properties": {
                      "success": {
                        "type": "boolean",
                        "example": "true"
                      }
                    },
                    "type": "object"
                  }
                }
              }
            },
            "400": {
              "description": "Неверные параметры запроса"
            },
            "401": {
              "description": "Требуется авторизация (Bearer JWT)"
            },
            "500": {
              "description": "Внутренняя ошибка сервера"
            }
          }
        }
      },
      "/api/client_user/reset_password/{login}": {
        "put": {
          "tags": [
            "ClientUser"
          ],
          "summary": "Сброс пароля пользователя клиента",
          "operationId": "put_api_client_user_reset_password",
          "parameters": [
            {
              "name": "Authorization",
              "in": "header",
              "description": "JWT-токен в формате: `Bearer <токен>`",
              "required": true,
              "schema": {
                "type": "string",
                "pattern": "^Bearer .+$",
                "example": "Bearer xxxxxxxx"
              }
            },
            {
              "name": "login",
              "in": "path",
              "description": "login пользователя, который нужно удалить",
              "required": true,
              "schema": {
                "type": "string",
                "example": "client_user_login"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Сброс пароля выполнен успешно",
              "content": {
                "application/json": {
                  "schema": {
                    "properties": {
                      "login": {
                        "type": "string",
                        "example": "ivanov"
                      },
                      "new_password": {
                        "type": "string",
                        "example": "secure123"
                      },
                      "success": {
                        "type": "boolean",
                        "example": "true"
                      }
                    },
                    "type": "object"
                  }
                }
              }
            },
            "400": {
              "description": "Неверные параметры запроса"
            },
            "401": {
              "description": "Требуется авторизация (Bearer JWT)"
            },
            "500": {
              "description": "Внутренняя ошибка сервера"
            }
          }
        }
      }
    },
    "tags": [
      {
        "name": "ClientUser",
        "description": "ClientUser"
      },
      {
        "name": "Token",
        "description": "Token"
      },
      {
        "name": "ClientBase",
        "description": "ClientBase"
      }
    ]
  }
}
</script>
